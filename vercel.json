{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/clanker-api/:path*",
      "destination": "https://www.clanker.world/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon|manifest|robots).*)",
      "destination": "/index.html"
    }
  ]
}
