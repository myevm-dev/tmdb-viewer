# TMDB v3 API key (defaults to the key bundled with the original project)
VITE_TMDB_API_KEY=

# Chain for fan club launches: 8453 = Base mainnet, 84532 = Base Sepolia
VITE_CHAIN_ID=8453

# Optional public RPC used for read-only calls before a wallet connects
VITE_RPC_URL=

# Clanker API base. "/clanker-api" is proxied by Vite (dev) and vercel.json (prod).
VITE_CLANKER_API=/clanker-api

# Optional launchpad fee: share of LP trading rewards routed to the platform.
# Leave blank to give creators 100% of rewards.
VITE_PLATFORM_FEE_RECIPIENT=
VITE_PLATFORM_FEE_BPS=2000
