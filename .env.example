# TMDB v3 API key (defaults to the key bundled with the original project)
VITE_TMDB_API_KEY=

# Chain for fan club launches: 8453 = Base mainnet, 84532 = Base Sepolia
VITE_CHAIN_ID=8453

# Optional public RPC used for read-only calls before a wallet connects
VITE_RPC_URL=

# Clanker API base. "/clanker-api" is proxied by Vite (dev) and vercel.json (prod).
VITE_CLANKER_API=/clanker-api

# Optional launchpad fee: share of LP trading rewards routed to the platform.
# Leave blank to give creators 100% of rewards.
VITE_PLATFORM_FEE_RECIPIENT=
VITE_PLATFORM_FEE_BPS=2000

# ---------------------------------------------------------------------------
# Live data indexer (Vercel Functions in /api). Leave DATABASE_URL unset to
# run without it — the app then falls back to the Clanker API + DexScreener.
# ---------------------------------------------------------------------------
# Postgres connection string (Vercel Storage > Neon sets DATABASE_URL for you).
# For local dev without Postgres: DATABASE_URL=pglite:./.data
DATABASE_URL=
# Base RPC with eth_getLogs (Alchemy/QuickNode/etc). Public RPC works but is rate-limited.
RPC_URL=
# Block to start indexing from (set to the block of your first launch). Default: ~7 days back.
INDEXER_START_BLOCK=
# Optional: Chainlink ETH/USD aggregator address; default uses Coinbase spot price.
ETH_USD_FEED=
# Optional: protect /api/sync for schedulers (send ?key=… or Authorization: Bearer …).
CRON_SECRET=
